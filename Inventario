diccionario = {
    'fruta' : ["manzana", "pera", "durazno", "sandia", "uva", "mandarina", "naranja", "coco", "melon"],
    'vegetales' : ["cebolla", "zanahoria", "aji", "yuca", "pepinillo", "papa", "aguacate"]
}

def ciclo(diccionario):
    for clave, arti in diccionario.items():
        print(f"\n----Categoria: {clave.upper()}")
        for i, art in enumerate(arti, start=1):
            print(f"{i}. {art}")

def eliminar_datos(diccionario):
    print("\n----ELIMINAR DATOS ----")
    print("Elige que quieres eliminar:")
    print("1. Categoria Completa")
    print("2. un Articulo especifico")
    opcion_eliminar = input("opcion  (1 o 2): ").lower()

    if opcion_eliminar == "1":
        categoria_a_eliminar = input("Nombre de la categoria a eliminar: ").lower().strip()
        if categoria_a_eliminar in diccionario:
            confirmacion = input(f"¿estas seguro que deseas eliminar {categoria_a_eliminar.upper()}? (si/no): ").lower().strip()
            if confirmacion == "si":
                diccionario.pop(categoria_a_eliminar)
                print(f"la categoria {categoria_a_eliminar} eliminada con exito")
            else:
                print("operacion cancelada")
        else:
            print("ERROR: categoria no encontrada.")

    elif opcion_eliminar == "2":
        categoria_padre = input("De que categoria deseas eliminar el articulo").lower().strip()

        if categoria_padre in diccionario:
            print(f"articulos actuales {categoria_padre.upper()}: {diccionario[categoria_padre]}")
            articulo_a_eliminar = input("Escribe el nonbre del articulos a eliminar ").lower().strip()

            try:
                diccionario[categoria_padre].remove(articulo_a_eliminar)
                print(f"articulo {articulo_a_eliminar} eliminado de {categoria_padre.upper()}. ")
            except ValueError:
                print(f"ERROR: El articulo {articulo_a_eliminar} no existe en esa categoria ")
        else:
            print("Error: Categoria no encontrada. ")

    else:
        print("opcion no valida. volviendo al menu principal. ")

def gestion_categorias(diccionario):
    print("Deseas agregar una categoria?")
    respuesta = input().lower()

    if respuesta == "si":
        nueva_categoria = input("Agrega la categoria: ").lower()
        if nueva_categoria in diccionario:
            print(f"la categoria {nueva_categoria} ya esta en el inventario, DESEAS ACTUALIZZAR ESTA CATEGORIA?")
            respuesta= input().lower()

            if respuesta == "si":
                act_articulos = input("Escribe los articulos separandolos con una (,): ").lower()

                list_temporal = act_articulos.split(',')

                list_limpia = []
                for act_arti in list_temporal:
                    text_limpio = act_arti.strip()
                    if text_limpio:
                        list_limpia.append(text_limpio)

                if list_limpia:
                    diccionario[nueva_categoria].extend(list_limpia)
                    print(f"la categoria {nueva_categoria} se ha actualizado la categoria con exito")
            else:
                print("No hay ningun dato valido")
        else:
            print(f"Agrega los articulos para {nueva_categoria}")
            articulos = input("Escribe las palabras separandolas con una (,): ").lower()

            lista_temporal = articulos.split(',')

            lista_limpia = []
            for articulo in lista_temporal:
                texto_limpio = articulo.strip()
                if texto_limpio:
                    lista_limpia.append(texto_limpio)
            if lista_limpia:
                diccionario[nueva_categoria] = lista_limpia
                print(f"La categoria {nueva_categoria} se ha guardado correctamenta")
            else:
                print("No se agregaran datos validos")
    elif respuesta == "no":
        print("OK. no se haran cambios")
    else:
        print("Respuesta no valida")


while True:
    print("\n\n ------------------------------------------")
    print(" *** MENU DE INVENTARIO *** ")
    print("1. Mostrar inventario")
    print("2. Agregar/Actualizar Categoria")
    print("3. eliminar: Categorias/Articulos")
    print("4. Salir del programa")
    print("\n\n ------------------------------------------")
    opcion = input("Selecciona una opcion 1,2,3 o 4: ")

    if opcion == "1":
        ciclo(diccionario)
    elif opcion == "2":
        gestion_categorias(diccionario)

    elif opcion == "3":
        eliminar_datos(diccionario)

    elif opcion == "4":
        print("Saliendo del programa")
        break
    else:
        print("opcion invalida, eliga una de las siguientes: 1,2,3 o 4")